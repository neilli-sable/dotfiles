{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'github-actions',
    'mise',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: 'Delay non-security updates for mise-managed tools to reduce supply-chain risk',
      matchManagers: [
        'mise',
      ],
      matchFileNames: [
        '.config/mise/config.toml',
      ],
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
    },
    {
      description: 'x/toolsのcmdはモジュールではなくGo proxyで引けず、リリース日時が取れないので、モジュール本体で引く',
      matchDatasources: [
        'go',
      ],
      matchPackageNames: [
        'golang.org/x/tools/cmd/**',
      ],
      overridePackageName: 'golang.org/x/tools',
    },
    {
      description: 'x/vulnのcmdはモジュールではなくGo proxyで引けず、リリース日時が取れないので、モジュール本体で引く',
      matchDatasources: [
        'go',
      ],
      matchPackageNames: [
        'golang.org/x/vuln/cmd/**',
      ],
      overridePackageName: 'golang.org/x/vuln',
    },
    {
      description: 'Delay non-security GitHub Actions updates to reduce supply-chain risk',
      matchManagers: [
        'github-actions',
      ],
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'strict',
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    prCreation: 'immediate',
    vulnerabilityFixStrategy: 'lowest',
    labels: [
      'security',
    ],
  },
}
